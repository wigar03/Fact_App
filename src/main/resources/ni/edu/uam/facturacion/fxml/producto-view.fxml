<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="860.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacion.controller.ProductoController">

    <top>
        <VBox style="-fx-background-color: #1e3a5f; -fx-padding: 14 24 14 24;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                    <Image url="@../images/logo.png"/>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Gestión de Productos"
                           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Registro, consulta y administración del inventario de productos"
                           style="-fx-text-fill: #b0bec5; -fx-font-size: 12px;"/>
                </VBox>
                <Button onAction="#onRegresarClick"
                        prefHeight="32.0"
                        style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 4; -fx-cursor: hand;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                <Image url="@../icons/cerrar.png"/>
                            </ImageView>
                            <Label text="Menú Principal" style="-fx-text-fill: white;"/>
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0"/>
            </padding>

            <VBox prefWidth="320.0" spacing="14"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #cfd8dc; -fx-border-radius: 8;">
                <Label text="Nuevo Producto"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>

                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="75.0" prefWidth="75.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-text-fill: #37474f; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtCodigo" promptText="Ej: PRD-004"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-background-radius: 4; -fx-border-radius: 4;"/>

                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-text-fill: #37474f; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del producto"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-background-radius: 4; -fx-border-radius: 4;"/>

                    <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-text-fill: #37474f; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbCategoria" maxWidth="Infinity"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"
                              style="-fx-background-radius: 4;"/>

                    <Label text="Precio ($):" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-text-fill: #37474f; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtPrecio" promptText="Ej: 15.50"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"
                               style="-fx-background-radius: 4; -fx-border-radius: 4;"/>

                    <Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                           style="-fx-text-fill: #37474f; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtStock" promptText="Ej: 20"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"
                               style="-fx-background-radius: 4; -fx-border-radius: 4;"/>
                </GridPane>

                <Label fx:id="lblMensaje" wrapText="true"
                       style="-fx-font-size: 12px;"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button onAction="#onLimpiarClick" text="Limpiar"
                            style="-fx-background-color: #eceff1; -fx-text-fill: #37474f; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    <Button onAction="#onAgregarClick"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                    <Image url="@../icons/agregar.png"/>
                                </ImageView>
                                <Label text="Agregar" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #cfd8dc; -fx-border-radius: 8;">
                <Label text="Listado de Productos Registrados"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>

                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código"/>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre"/>
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría"/>
                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio ($)"/>
                        <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #e0e0e0; -fx-padding: 6 16 6 16;">
            <Label text="Módulo de Productos | ni.edu.uam.facturacion"
                   style="-fx-font-size: 11px; -fx-text-fill: #616161;"/>
        </HBox>
    </bottom>

</BorderPane>
