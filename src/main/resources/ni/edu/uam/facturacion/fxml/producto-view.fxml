<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.ProductoController">
   <top>
      <VBox spacing="4.0" style="-fx-background-color: #2c3e50; -fx-padding: 14px 20px;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Gestión de Productos" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Registro y administración de catálogo de productos" textFill="#bdc3c7">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="380.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Datos del Producto">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="90.0" prefWidth="95.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="110.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Código:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtCodigo" promptText="Ej: PRD-001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Nombre:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Categoría:" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione una categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Precio:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label text="Existencia:" GridPane.rowIndex="4" />
                  <TextField fx:id="txtExistencia" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <Label text="Estado:" GridPane.rowIndex="5" />
                  <CheckBox fx:id="chkActivo" mnemonicParsing="false" selected="true" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                  <Label text="Imagen:" GridPane.rowIndex="6" GridPane.valignment="TOP">
                     <GridPane.margin>
                        <Insets top="6.0" />
                     </GridPane.margin>
                  </Label>
                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                     <children>
                        <StackPane maxHeight="100.0" maxWidth="100.0" minHeight="100.0" minWidth="100.0" prefHeight="100.0" prefWidth="100.0" style="-fx-border-color: #cccccc; -fx-border-radius: 4px; -fx-background-color: #f9f9f9;">
                           <children>
                              <ImageView fx:id="imgProducto" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <Button fx:id="btnImagen" mnemonicParsing="false" onAction="#seleccionarImagen" text="Seleccionar Imagen..." />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" prefHeight="32.0" prefWidth="100.0" style="-fx-base: #27ae60; -fx-text-fill: white;" text="Guardar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/agregar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#cerrar" prefHeight="32.0" prefWidth="100.0" text="Cerrar">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/cerrar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Listado de Productos">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colCodigo" prefWidth="85.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="110.0" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                <TableColumn fx:id="colExistencia" prefWidth="85.0" text="Existencia" />
                <TableColumn fx:id="colActivo" prefWidth="65.0" text="Activo" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="16.0" left="8.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
