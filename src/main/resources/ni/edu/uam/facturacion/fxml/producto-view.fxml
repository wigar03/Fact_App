<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="680.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacion.controller.ProductoController">
   <top>
      <VBox spacing="4.0" style="-fx-background-color: #2c3e50; -fx-padding: 14px 20px;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Gestión de Productos" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Registro y administración de catálogo de productos" textFill="#bdc3c7">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <left>
      <VBox prefWidth="380.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Datos del Producto">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="110.0" minWidth="90.0" prefWidth="95.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="110.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Código:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtCodigo" promptText="Ej: PRD-001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Nombre:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Categoría:" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione una categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Precio:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                  <Label text="Existencia:" GridPane.rowIndex="4" />
                  <TextField fx:id="txtExistencia" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <Label text="Estado:" GridPane.rowIndex="5" />
                  <CheckBox fx:id="chkActivo" mnemonicParsing="false" selected="true" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                  <Label text="Imagen:" GridPane.rowIndex="6" GridPane.valignment="TOP">
                     <GridPane.margin>
                        <Insets top="6.0" />
                     </GridPane.margin>
                  </Label>
                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                     <children>
                        <StackPane fx:id="paneContenedorImagen" maxHeight="100.0" maxWidth="100.0" minHeight="100.0" minWidth="100.0" prefHeight="100.0" prefWidth="100.0" style="-fx-border-color: #cccccc; -fx-border-radius: 4px; -fx-background-color: #f9f9f9;">
                           <children>
                              <Label fx:id="lblSinImagen" text="Sin imagen" textFill="#94a3b8" />
                              <ImageView fx:id="imgProducto" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <HBox spacing="6.0">
                           <children>
                              <Button fx:id="btnImagen" mnemonicParsing="false" onAction="#seleccionarImagen" text="Seleccionar..." />
                              <Button fx:id="btnQuitarImagen" mnemonicParsing="false" onAction="#quitarImagen" text="Quitar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <Separator prefWidth="200.0" />
            <GridPane hgap="8.0" vgap="8.0">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="32.0" prefHeight="32.0" />
                <RowConstraints minHeight="32.0" prefHeight="32.0" />
                <RowConstraints minHeight="32.0" prefHeight="32.0" />
              </rowConstraints>
               <children>
                  <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" style="-fx-base: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/agregar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="btnActualizar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" style="-fx-base: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" text="Actualizar" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" style="-fx-base: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Button fx:id="btnNuevo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiar" text="Limpiar / Nuevo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Button fx:id="btnCerrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cerrar" text="Cerrar" GridPane.columnSpan="2" GridPane.rowIndex="2">
                     <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../icons/cerrar.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Listado de Productos">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

            <!-- Barra de Búsqueda (Sección 12) -->
            <HBox alignment="CENTER_LEFT" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4px; -fx-background-color: white;">
               <children>
                  <Label alignment="CENTER" prefHeight="34.0" prefWidth="80.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-width: 0 1 0 0; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Buscar" />
                  <TextField fx:id="txtBuscar" prefHeight="34.0" promptText="Código, nombre o categoría" style="-fx-background-color: transparent; -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </TextField>
                  <Button fx:id="btnLimpiarBusqueda" mnemonicParsing="false" onAction="#limpiarBusqueda" prefHeight="34.0" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 0 0 0 1; -fx-cursor: hand; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Limpiar búsqueda">
                     <padding>
                        <Insets left="14.0" right="14.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>

            <!-- Filtros adicionales (Sección 14) -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Estado:" textFill="#475569">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cmbFiltroEstado" prefHeight="30.0" prefWidth="200.0" promptText="Todos los productos" />

                  <Label text="Categoría:" textFill="#475569">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="6.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="cmbFiltroCategoria" prefHeight="30.0" prefWidth="200.0" promptText="Todas las categorías" />

                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblConteoRegistros" text="0 productos" textFill="#64748b">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tblProductos">
                    <columns>
                      <TableColumn fx:id="colImagen" maxWidth="75.0" minWidth="65.0" prefWidth="70.0" text="Foto" />
                      <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                      <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                      <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                      <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                      <TableColumn fx:id="colExistencia" prefWidth="85.0" text="Existencia" />
                      <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Capa de superposición para zoom flotante de la tabla que sobresale sin cortarse -->
                  <Pane fx:id="paneOverlayTabla" mouseTransparent="true" pickOnBounds="false">
                     <children>
                        <VBox fx:id="zoomCardTabla" alignment="CENTER" managed="false" mouseTransparent="true" spacing="6.0" style="-fx-background-color: white; -fx-padding: 8px; -fx-background-radius: 8px; -fx-border-color: #94a3b8; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.45), 18, 0, 0, 5);" visible="false">
                           <children>
                              <ImageView fx:id="imgZoomTabla" fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
                              <Label fx:id="lblZoomNombreTabla" alignment="CENTER" maxWidth="140.0" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #1e293b;" textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </Pane>
               </children>
            </StackPane>
         </children>
         <padding>
            <Insets bottom="16.0" left="8.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
