<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="750.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacion.controller.MenuPrincipalController">

    <!-- Encabezado Superior -->
    <top>
        <VBox style="-fx-background-color: #1e3a5f; -fx-padding: 18 24 18 24;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <ImageView fitHeight="56.0" fitWidth="56.0" preserveRatio="true">
                    <Image url="@../images/logo.png"/>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="SISTEMA DE FACTURACIÓN"
                           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Universidad Americana (UAM) - Campus Managua"
                           style="-fx-text-fill: #b0bec5; -fx-font-size: 13px;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenido Central: Panel de Opciones -->
    <center>
        <VBox alignment="CENTER" spacing="24">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="8">
                <Label text="Menú Principal"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                <Label text="Seleccione el módulo al que desea ingresar:"
                       style="-fx-font-size: 14px; -fx-text-fill: #546e7a;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="20">
                <!-- Tarjeta / Botón Módulo Productos -->
                <Button onAction="#onProductosClick"
                        prefHeight="120.0" prefWidth="220.0"
                        style="-fx-background-color: white; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="📦" style="-fx-font-size: 28px;"/>
                            <Label text="Gestión de Productos"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                            <Label text="Catálogo y existencias"
                                   style="-fx-font-size: 11px; -fx-text-fill: #78909c;"/>
                        </VBox>
                    </graphic>
                </Button>

                <!-- Tarjeta Módulo Facturación (Próximamente) -->
                <Button disable="true"
                        prefHeight="120.0" prefWidth="220.0"
                        style="-fx-background-color: #eceff1; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="🧾" style="-fx-font-size: 28px;"/>
                            <Label text="Facturación"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                            <Label text="Emisión de facturas"
                                   style="-fx-font-size: 11px; -fx-text-fill: #90a4ae;"/>
                        </VBox>
                    </graphic>
                </Button>
            </HBox>

            <Separator maxWidth="500.0"/>

            <!-- Botón Salir -->
            <Button onAction="#onSalirClick"
                    prefHeight="38.0" prefWidth="140.0"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                            <Image url="@../icons/cerrar.png"/>
                        </ImageView>
                        <Label text="Salir" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </center>

    <!-- Barra Inferior -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #e0e0e0; -fx-padding: 8 16 8 16;">
            <Label text="Estado: Conectado | Java 21 LTS - JavaFX 21"
                   style="-fx-font-size: 11px; -fx-text-fill: #616161;"/>
        </HBox>
    </bottom>

</BorderPane>
